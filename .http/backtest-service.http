@backtestHost = http://localhost:8084
@symbol = TQQQ
@from = 2025-01-01
@to = 2025-12-31
@runId = 00000000-0000-0000-0000-000000000000

# Prerequisite:
# docker compose -f docker-compose.backtest.yml up -d --build yfinance-sidecar

### Import daily market data from yfinance sidecar
POST {{backtestHost}}/backtests/market-data/import
Content-Type: application/json

{
  "symbol": "{{symbol}}",
  "market": "US",
  "from": "{{from}}",
  "to": "{{to}}",
  "autoAdjust": false,
  "timeoutSeconds": 30
}

### Create backtest run summary with market data refresh
POST {{backtestHost}}/backtests/runs
Content-Type: application/json

{
  "symbol": "{{symbol}}",
  "market": "US",
  "from": "{{from}}",
  "to": "{{to}}",
  "initialCash": 10000,
  "strategyType": "BUY_AND_HOLD",
  "commissionRate": 0,
  "slippageRate": 0,
  "refreshMarketData": true,
  "autoAdjust": false,
  "marketDataTimeoutSeconds": 30
}

### Run backtest summary with legacy endpoint
POST {{backtestHost}}/backtests/run
Content-Type: application/json

{
  "symbol": "{{symbol}}",
  "market": "US",
  "from": "{{from}}",
  "to": "{{to}}",
  "initialCash": 10000,
  "strategyType": "BUY_AND_HOLD",
  "commissionRate": 0,
  "slippageRate": 0,
  "refreshMarketData": true,
  "autoAdjust": false,
  "marketDataTimeoutSeconds": 30
}

### Find backtest run summary
GET {{backtestHost}}/backtests/runs/{{runId}}

### Find backtest run trades
GET {{backtestHost}}/backtests/runs/{{runId}}/trades?page=0&size=100

### Find backtest run equity curve monthly
GET {{backtestHost}}/backtests/runs/{{runId}}/equity-curve?granularity=MONTHLY
