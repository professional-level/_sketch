@backtestHost = http://localhost:8084
@symbol = TQQQ
@from = 2025-01-01
@to = 2025-12-31

# Prerequisite:
# docker compose -f docker-compose.backtest.yml up -d --build yfinance-sidecar

### Import daily market data from yfinance sidecar
POST {{backtestHost}}/backtests/market-data/import
Content-Type: application/json

{
  "symbol": "{{symbol}}",
  "market": "US",
  "from": "{{from}}",
  "to": "{{to}}",
  "autoAdjust": false,
  "timeoutSeconds": 30
}

### Create backtest run summary with market data refresh
POST {{backtestHost}}/backtests/runs
Content-Type: application/json

{
  "symbol": "{{symbol}}",
  "market": "US",
  "from": "{{from}}",
  "to": "{{to}}",
  "initialCash": 10000,
  "strategyType": "BUY_AND_HOLD",
  "commissionRate": 0,
  "slippageRate": 0,
  "refreshMarketData": true,
  "autoAdjust": false,
  "marketDataTimeoutSeconds": 30
}
> {%
    client.global.set("runId", response.body.runId);
%}

### Run Laor V4 backtest summary
POST {{backtestHost}}/backtests/laor-v4/runs
Content-Type: application/json

{
  "symbol": "{{symbol}}",
  "market": "US",
  "from": "{{from}}",
  "to": "{{to}}",
  "initialCash": 10000,
  "totalSplitCount": 40,
  "firstBuyLimitPercentAbovePreviousClose": 12,
  "autoRestart": true,
  "dividendReinvestment": false,
  "refreshMarketData": true,
  "autoAdjust": false,
  "marketDataTimeoutSeconds": 30
}
> {%
    client.global.set("runId", response.body.runId);
%}

### Find Laor V4 backtest result
GET {{backtestHost}}/backtests/laor-v4/runs/{{runId}}

### Find backtest run trades
GET {{backtestHost}}/backtests/runs/{{runId}}/trades?page=0&size=100

### Find backtest run equity curve monthly
GET {{backtestHost}}/backtests/runs/{{runId}}/equity-curve?granularity=MONTHLY
