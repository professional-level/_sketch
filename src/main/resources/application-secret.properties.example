# Copy this file to application-secret.properties for local use.
# Never commit the real application-secret.properties file.
# Deployed environments can inject the equivalent KIS_* environment variables instead.

base_url=https://openapi.koreainvestment.com:9443
app_key=REPLACE_WITH_REAL_APP_KEY
app_secret=REPLACE_WITH_REAL_APP_SECRET

mock_base_url=https://openapivts.koreainvestment.com:29443
mock_app_key=REPLACE_WITH_MOCK_APP_KEY
mock_app_secret=REPLACE_WITH_MOCK_APP_SECRET
mock_account=00000000
mock_account_tail=01

# Optional real trading account values. Leave blank until real-order paths are validated.
account=
account_tail=

# Toss Securities Open API. Keep real values local only.
akra.openapi.toss.client-id=REPLACE_WITH_TOSS_CLIENT_ID
akra.openapi.toss.client-secret=REPLACE_WITH_TOSS_CLIENT_SECRET
akra.openapi.toss.default-account-number=
